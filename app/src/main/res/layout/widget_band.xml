<?xml version="1.0" encoding="utf-8"?>
<!--
    The 4×1 band widget, in the app's page tone; filled by BandWidget. The band itself sits
    faintly behind the state chip (ON · 84 %, OFF, DISCONNECTED) and the profile's name.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <!-- The band composed into the picture itself (150 % of the height, 10 % right, 40 % down):
         widgets can't place an image like that, a picture that fills them can. -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.28"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_band" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="10dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="12dp"
            android:importantForAccessibility="no"
            android:src="@drawable/app_mark" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_chip_stop"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:singleLine="true"
                android:text="OFF"
                android:textColor="#FF1E0F0E"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:contentDescription="Choose a profile"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:text="Profile 1  ›"
                android:textColor="#FF111214"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Power above, gestures below: a column, so the text keeps the width. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widget_power"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/widget_button_stop"
                android:contentDescription="Band connection"
                android:padding="8dp"
                android:src="@drawable/ic_power" />

            <ImageView
                android:id="@+id/widget_controls"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/widget_button_stop"
                android:contentDescription="Gestures"
                android:padding="8dp"
                android:src="@drawable/ic_hand" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
