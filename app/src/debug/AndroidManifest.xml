<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: the test hook (see DebugActions). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- The handwriting recorder, with its own launcher entry (debug builds only). -->
        <activity
            android:name=".RecordActivity"
            android:exported="true"
            android:label="Handwriting recorder"
            android:taskAffinity="dev.kb896.airgestures.handwriting"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Writing words with the band (debug builds only), its own launcher entry too. -->
        <activity
            android:name=".WriteActivity"
            android:exported="true"
            android:label="Handwriting: words"
            android:taskAffinity="dev.kb896.airgestures.words"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".DebugActions"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="dev.kb896.airgestures.RUN" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
