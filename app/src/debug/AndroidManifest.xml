<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: the test hook (see DebugActions). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- The band's own handwriting, token by token (debug builds only), its own launcher entry. -->
        <activity
            android:name=".BandWriteActivity"
            android:exported="true"
            android:label="Band handwriting"
            android:taskAffinity="dev.kb896.airgestures.bandwrite"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".DebugActions"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="dev.kb896.airgestures.RUN" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
